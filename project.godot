; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Soap Escape"
run/main_scene="res://scenes/Main.tscn"
config/icon="res://SoapEscape_AppIcon_1024.png"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.992157, 0.94902, 0.972549, 1)
boot_splash/show_image=false

[autoload]

GameData="*res://autoloads/GameData.gd"
AudioManager="*res://autoloads/AudioManager.gd"
SaveData="*res://autoloads/SaveData.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[input]

lean_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)
]
}
lean_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="soap_body"
2d_physics/layer_2="walls"
2d_physics/layer_3="unused"
2d_physics/layer_4="wet_zones"
2d_physics/layer_5="pickups"
2d_physics/layer_6="finish_line"

[rendering]

; Required for iOS export. Without it the Apple-embedded exporter fails
; has_valid_project_configuration(), and because that branch sets valid=false
; without appending to the error string, Godot reports a configuration error
; with an empty list, which is impossible to diagnose from the message alone.
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
